+{% extends 'base.html' %}{% from 'macros.html' import csrf %}
+{% block title %}Feedback · StudentConnect{% endblock %}
+{% block content %}<section class="card"><h1>Tell us how it went</h1>
+<p class="sub">This takes about two minutes. Your answers are saved with your account so the owner can follow up; they are not shared with other testers.</p>
+<form method="post" class="page-form">{{ csrf() }}
+<label class="field">How accurate were the match scores for your resume?
+<select name="accuracy" required><option value="" selected disabled>Choose 1 to 5</option>
+<option value="1">1 · Not accurate</option><option value="2">2</option><option value="3">3 · Okay</option><option value="4">4</option><option value="5">5 · Very accurate</option></select></label>
+<label class="field">How easy was StudentConnect to use?
+<select name="ease" required><option value="" selected disabled>Choose 1 to 5</option>
+<option value="1">1 · Hard</option><option value="2">2</option><option value="3">3 · Okay</option><option value="4">4</option><option value="5">5 · Very easy</option></select></label>
+<label class="field">Did anything break, feel slow, or confuse you?
+<textarea name="issues" maxlength="2000" rows="4"></textarea></label>
+<label class="field">What feature would make this more useful?
+<textarea name="feature_request" maxlength="2000" rows="4"></textarea></label>
+<label class="field">Would you use this for real applications?
+<select name="would_use" required><option value="" selected disabled>Choose one</option>
+<option value="yes">Yes</option><option value="maybe">Maybe</option><option value="no">No</option></select></label>
+<button class="btn p" type="submit">Send feedback</button></form></section>{% endblock %}
