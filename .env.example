# Local commands read process variables. Hosted wsgi.py loads the private .env only.
GROQ_API_KEY=
# Optional ordered fallback slots for the cloud matching worker.
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_API_KEY_7=
# Optional supplemental discovery in the existing local five-minute hosted-data worker.
# Keys are selected in round-robin order by reserved search ID. Blank slots are skipped.
# The app's shared daily/monthly search caps still apply. Store real keys only in .env.
TAVILY_API_KEY=
TAVILY_API_KEY_2=
TAVILY_API_KEY_3=
GMAIL_APP_PASSWORD=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_CONTEXT_TOKENS=131072
DIGEST_FROM_EMAIL=your-sending-account@gmail.com
# Hosted deployment only. Leave BASE_URL empty for localhost development.
STUDENTCONNECT_BASE_URL=
# Generate once using secrets.token_hex(32); store privately, never commit it.
STUDENTCONNECT_SECRET_KEY=
# Google OAuth Web application credentials. Set both to enable public Google signup.
# Authorized redirect URI: <site origin>/auth/google/callback
STUDENTCONNECT_GOOGLE_CLIENT_ID=
STUDENTCONNECT_GOOGLE_CLIENT_SECRET=
# Cloud automation only: separate 64-hex credential shared with GitHub Actions.
# Leave blank to disable worker API access and retain local matching behavior.
STUDENTCONNECT_WORKER_KEY=
# Optional LOCAL browser application worker. Never expose these to frontend code.
GEMINI_API_KEY=
# Select a supported generateContent model explicitly; no guessed model default.
GEMINI_MODEL=
# Optional explanation-only LLM gateway. Providers are disabled unless both model sizes
# and all three explicit budgets are set. Scores never use LLM output.
GROQ_LARGE_MODEL=
GEMINI_LARGE_MODEL=
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
CEREBRAS_LARGE_MODEL=
OLLAMA_MODEL=
OLLAMA_LARGE_MODEL=
OLLAMA_BASE_URL=
LLM_GROQ_RPM=
LLM_GROQ_DAILY_REQUESTS=
LLM_GROQ_DAILY_TOKENS=
LLM_GEMINI_RPM=
LLM_GEMINI_DAILY_REQUESTS=
LLM_GEMINI_DAILY_TOKENS=
LLM_CEREBRAS_RPM=
LLM_CEREBRAS_DAILY_REQUESTS=
LLM_CEREBRAS_DAILY_TOKENS=
LLM_OLLAMA_RPM=
LLM_OLLAMA_DAILY_REQUESTS=
LLM_OLLAMA_DAILY_TOKENS=
# Optional persistent Notion integration shared with your application tracker.
# Configure both or neither. The data-source ID differs from the database page ID.
STUDENTCONNECT_NOTION_TOKEN=
STUDENTCONNECT_NOTION_SOURCE=
