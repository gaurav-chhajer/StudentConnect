# Local commands read process variables. Hosted wsgi.py loads the private .env only.
GROQ_API_KEY=
GMAIL_APP_PASSWORD=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_CONTEXT_TOKENS=131072
# Optional cloud fallback: full resume/JD is sent to Gemini after a Groq HTTP 429.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_CONTEXT_TOKENS=1048576
DIGEST_FROM_EMAIL=your-sending-account@gmail.com
# Hosted deployment only. Leave BASE_URL empty for localhost development.
STUDENTCONNECT_BASE_URL=
# Generate once using secrets.token_hex(32); store privately, never commit it.
STUDENTCONNECT_SECRET_KEY=
# Cloud automation only: separate 64-hex credential shared with GitHub Actions.
# Leave blank to disable worker API access and retain local matching behavior.
STUDENTCONNECT_WORKER_KEY=
